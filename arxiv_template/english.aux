\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Dataset overview: three data sources. \textbf  {Top row}---Synthetic V3: programmatically generated with randomized topologies (5--30 components, 10 types), GT recorded synchronously via \texttt  {draw.text()}. \textbf  {Middle row}---train-real (KiCad): real open-source projects from GitHub, rendered via kicad-cli SVG$\to $cairosvg PNG, GT extracted from SVG stroked-text. \textbf  {Bottom row}---Test set (easy50-pure): held-out real schematics for evaluation. All images are raw PNG renders with zero AI-generated labels.}}{9}{figure.caption.2}\protected@file@percent }
\newlabel{fig:dataset_overview}{{2}{9}{Dataset overview: three data sources. \textbf {Top row}---Synthetic V3: programmatically generated with randomized topologies (5--30 components, 10 types), GT recorded synchronously via \texttt {draw.text()}. \textbf {Middle row}---train-real (KiCad): real open-source projects from GitHub, rendered via kicad-cli SVG$\to $cairosvg PNG, GT extracted from SVG stroked-text. \textbf {Bottom row}---Test set (easy50-pure): held-out real schematics for evaluation. All images are raw PNG renders with zero AI-generated labels}{figure.caption.2}{}}
\newlabel{fig:dataset_overview@cref}{{[figure][2][]2}{[1][2][]9}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Dataset composition. Left: full V5 Golden breakdown (1,857 total). Center: training set dominated by real KiCad projects (71\%). Right: validation set follows a similar distribution. Synthetic V3 data is the minority in all splits (29\% train, 23\% val), yet its influence on model behavior is disproportionate (see Section~7.3).}}{10}{figure.caption.4}\protected@file@percent }
\newlabel{fig:dataset_donut}{{3}{10}{Dataset composition. Left: full V5 Golden breakdown (1,857 total). Center: training set dominated by real KiCad projects (71\%). Right: validation set follows a similar distribution. Synthetic V3 data is the minority in all splits (29\% train, 23\% val), yet its influence on model behavior is disproportionate (see Section~7.3)}{figure.caption.4}{}}
\newlabel{fig:dataset_donut@cref}{{[figure][3][]3}{[1][2][]10}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Multi-metric checkpoint sweep across V10-Fixed training. Top: CompF1, TokenRec, and Diversity --- S600 achieves the best balance (marked). Bottom: NED and RepRate --- S600 achieves lowest NED (0.8031), while S800's RepRate triples with only marginal CompF1 gain.}}{10}{figure.caption.8}\protected@file@percent }
\newlabel{fig:checkpoint_sweep}{{5}{10}{Multi-metric checkpoint sweep across V10-Fixed training. Top: CompF1, TokenRec, and Diversity --- S600 achieves the best balance (marked). Bottom: NED and RepRate --- S600 achieves lowest NED (0.8031), while S800's RepRate triples with only marginal CompF1 gain}{figure.caption.8}{}}
\newlabel{fig:checkpoint_sweep@cref}{{[figure][5][]5}{[1][5][]10}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Model comparison: three test examples showing the original schematic, ground truth netlist, base model output, and S600 output. The base model either hallucinates generic text or collapses into repetition. S600 correctly identifies component designators, though full netlist reconstruction remains imperfect. See Appendix~D for 8 annotated examples with per-sample verdicts.}}{11}{figure.caption.9}\protected@file@percent }
\newlabel{fig:model_comparison}{{6}{11}{Model comparison: three test examples showing the original schematic, ground truth netlist, base model output, and S600 output. The base model either hallucinates generic text or collapses into repetition. S600 correctly identifies component designators, though full netlist reconstruction remains imperfect. See Appendix~D for 8 annotated examples with per-sample verdicts}{figure.caption.9}{}}
\newlabel{fig:model_comparison@cref}{{[figure][6][]6}{[1][5][]11}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Phase 2 topology capacity gap. comp\_f1 (blue, refdes-only) is 10.8$\times $ higher than joint\_f1 (orange, refdes+value). The gap quantifies the value hallucination problem: 87\% of component values are wrong even when the designator is identified. value\_acc (green) remains below 0.13 for all models.}}{12}{figure.caption.11}\protected@file@percent }
\newlabel{fig:topology_gap}{{7}{12}{Phase 2 topology capacity gap. comp\_f1 (blue, refdes-only) is 10.8$\times $ higher than joint\_f1 (orange, refdes+value). The gap quantifies the value hallucination problem: 87\% of component values are wrong even when the designator is identified. value\_acc (green) remains below 0.13 for all models}{figure.caption.11}{}}
\newlabel{fig:topology_gap@cref}{{[figure][7][]7}{[1][5][]12}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Version progression from V3 through V12. NED (red line, left axis) trends downward from V3 to V9 then rises in V11/V12. Diversity (green diamonds, right axis) jumps from 4\% to 90\% at V5 (LLM-Only LoRA) and remains high through V10-Fixed, then collapses in V11/V12. The shaded region marks versions that have not yet converged to a useful training recipe.}}{12}{figure.caption.12}\protected@file@percent }
\newlabel{fig:version_progression}{{8}{12}{Version progression from V3 through V12. NED (red line, left axis) trends downward from V3 to V9 then rises in V11/V12. Diversity (green diamonds, right axis) jumps from 4\% to 90\% at V5 (LLM-Only LoRA) and remains high through V10-Fixed, then collapses in V11/V12. The shaded region marks versions that have not yet converged to a useful training recipe}{figure.caption.12}{}}
\newlabel{fig:version_progression@cref}{{[figure][8][]8}{[1][6][]12}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Comparison of all model variants across three key metrics. Left: CompF1 --- S600 achieves the best value (0.2061), while V11 and V12 collapse below or near the Base model. Center: Token Recall --- the 96$\times $ gain from Base to S600 is lost in V11/V12. Right: Repetition Rate --- V11/V12 collapse manifests as near-100\% repetition, far exceeding even S800's 40.9\%.}}{13}{figure.caption.13}\protected@file@percent }
\newlabel{fig:model_metrics_bar}{{9}{13}{Comparison of all model variants across three key metrics. Left: CompF1 --- S600 achieves the best value (0.2061), while V11 and V12 collapse below or near the Base model. Center: Token Recall --- the 96$\times $ gain from Base to S600 is lost in V11/V12. Right: Repetition Rate --- V11/V12 collapse manifests as near-100\% repetition, far exceeding even S800's 40.9\%}{figure.caption.13}{}}
\newlabel{fig:model_metrics_bar@cref}{{[figure][9][]9}{[1][6][]13}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces (a) Training loss curves for V10-Fixed (1,165 steps) and V11 (800 steps). V10 SFT loss converges smoothly from 2.71 to 0.30; checkpoints S400, S600, and S800 are marked. V11 loss is higher and more volatile despite a larger training set (3,054 vs.\ 1,554 samples), reflecting the destabilizing effect of regularization at this model scale. (b) Cosine annealing learning rate schedule for both runs.}}{14}{figure.caption.14}\protected@file@percent }
\newlabel{fig:training_curves}{{10}{14}{(a) Training loss curves for V10-Fixed (1,165 steps) and V11 (800 steps). V10 SFT loss converges smoothly from 2.71 to 0.30; checkpoints S400, S600, and S800 are marked. V11 loss is higher and more volatile despite a larger training set (3,054 vs.\ 1,554 samples), reflecting the destabilizing effect of regularization at this model scale. (b) Cosine annealing learning rate schedule for both runs}{figure.caption.14}{}}
\newlabel{fig:training_curves@cref}{{[figure][10][]10}{[1][6][]14}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces V11 checkpoint sweep: RepRate (right axis, purple) rises monotonically with training steps from 43.2\% (S200) to 93.2\% (S800), while CompF1 (left axis, red) never exceeds 0.069 and ultimately falls below the baseline. More training under regularization exacerbates rather than mitigates collapse.}}{15}{figure.caption.15}\protected@file@percent }
\newlabel{fig:v11_collapse}{{11}{15}{V11 checkpoint sweep: RepRate (right axis, purple) rises monotonically with training steps from 43.2\% (S200) to 93.2\% (S800), while CompF1 (left axis, red) never exceeds 0.069 and ultimately falls below the baseline. More training under regularization exacerbates rather than mitigates collapse}{figure.caption.15}{}}
\newlabel{fig:v11_collapse@cref}{{[figure][11][]11}{[1][7][]15}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Raw dataset samples. Top row: Synthetic V3 (programmatic generation, GT from \texttt  {draw.text()} logs). Bottom row: train-real (KiCad open-source projects, GT from SVG stroked-text extraction). All images are raw PNG renders.}}{16}{figure.caption.18}\protected@file@percent }
