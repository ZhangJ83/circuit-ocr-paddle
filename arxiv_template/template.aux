\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces 模型对比：三个测试样本，分别展示原始原理图、GT 网表、基座模型输出、S600 输出。基座模型要么幻觉通用文本，要么塌缩为重复输出。S600 能正确识别元件编号，但完整网表重建仍有不足。8 个带逐样本判决的标注示例见附录\hspace  {0.25em plus 0.125em minus 0.08em}\ignorespaces D。}}{12}{figure.caption.9}\protected@file@percent }
\newlabel{fig:model_comparison}{{6}{12}{模型对比：三个测试样本，分别展示原始原理图、GT 网表、基座模型输出、S600 输出。基座模型要么幻觉通用文本，要么塌缩为重复输出。S600 能正确识别元件编号，但完整网表重建仍有不足。8 个带逐样本判决的标注示例见附录~D。}{figure.caption.9}{}}
\newlabel{fig:model_comparison@cref}{{[figure][6][]6}{[1][5][]12}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces 阶段二拓扑能力落差。comp\_f1（蓝，仅标号）比 joint\_f1（橙，标号+值）高 10.8$\times $。这一差距量化了值幻觉问题：即使标号识别正确，87\% 的元件值仍是错误的。value\_acc（绿）在所有模型中均低于 0.13。}}{13}{figure.caption.11}\protected@file@percent }
\newlabel{fig:topology_gap}{{7}{13}{阶段二拓扑能力落差。comp\_f1（蓝，仅标号）比 joint\_f1（橙，标号+值）高 10.8$\times $。这一差距量化了值幻觉问题：即使标号识别正确，87\% 的元件值仍是错误的。value\_acc（绿）在所有模型中均低于 0.13。}{figure.caption.11}{}}
\newlabel{fig:topology_gap@cref}{{[figure][7][]7}{[1][6][]13}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces 从 V3 到 V12 的版本演进。NED（红线，左轴）从 V3 到 V9 逐步下降，V11/V12 中回升。Diversity（绿色菱形，右轴）在 V5（LLM-Only LoRA）从 4\% 跃升至 90\%，并在 V10-Fixed 之前保持高位，随后在 V11/V12 中塌缩。阴影区域标记尚未收敛到可用训练方案的版本。}}{13}{figure.caption.12}\protected@file@percent }
\newlabel{fig:version_progression}{{8}{13}{从 V3 到 V12 的版本演进。NED（红线，左轴）从 V3 到 V9 逐步下降，V11/V12 中回升。Diversity（绿色菱形，右轴）在 V5（LLM-Only LoRA）从 4\% 跃升至 90\%，并在 V10-Fixed 之前保持高位，随后在 V11/V12 中塌缩。阴影区域标记尚未收敛到可用训练方案的版本。}{figure.caption.12}{}}
\newlabel{fig:version_progression@cref}{{[figure][8][]8}{[1][6][]13}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces 所有模型变体在三个关键指标上的对比。左：CompF1——S600 取得最优值（0.2061），而 V11 和 V12 塌缩至基线附近或以下。中：Token Recall——Base 到 S600 的 96$\times $ 增益在 V11/V12 中完全丧失。右：Repetition Rate——V11/V12 塌缩表现为近乎 100\% 的重复输出，远超 S800 的 40.9\%。}}{14}{figure.caption.13}\protected@file@percent }
\newlabel{fig:model_metrics_bar}{{9}{14}{所有模型变体在三个关键指标上的对比。左：CompF1——S600 取得最优值（0.2061），而 V11 和 V12 塌缩至基线附近或以下。中：Token Recall——Base 到 S600 的 96$\times $ 增益在 V11/V12 中完全丧失。右：Repetition Rate——V11/V12 塌缩表现为近乎 100\% 的重复输出，远超 S800 的 40.9\%。}{figure.caption.13}{}}
\newlabel{fig:model_metrics_bar@cref}{{[figure][9][]9}{[1][6][]14}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces (a) V10-Fixed（1,165 步）与 V11（800 步）的训练 loss 曲线。V10 SFT loss 从 2.71 平滑收敛至 0.30；标注了检查点 S400、S600、S800。V11 尽管训练集更大（3,054 vs.\ 1,554），loss 更高且更不稳定，反映了正则化在此模型规模下的失稳效应。(b) 两者的余弦退火学习率调度。}}{15}{figure.caption.14}\protected@file@percent }
\newlabel{fig:training_curves}{{10}{15}{(a) V10-Fixed（1,165 步）与 V11（800 步）的训练 loss 曲线。V10 SFT loss 从 2.71 平滑收敛至 0.30；标注了检查点 S400、S600、S800。V11 尽管训练集更大（3,054 vs.\ 1,554），loss 更高且更不稳定，反映了正则化在此模型规模下的失稳效应。(b) 两者的余弦退火学习率调度。}{figure.caption.14}{}}
\newlabel{fig:training_curves@cref}{{[figure][10][]10}{[1][7][]15}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces V11 检查点扫描：RepRate（右轴，紫色）随训练步数单调递增，从 S200 的 43.2\% 升至 S800 的 93.2\%，而 CompF1（左轴，红色）从未超过 0.069，最终跌至基线以下。在正则化下延长训练会加剧而非缓解塌缩。}}{16}{figure.caption.15}\protected@file@percent }
\newlabel{fig:v11_collapse}{{11}{16}{V11 检查点扫描：RepRate（右轴，紫色）随训练步数单调递增，从 S200 的 43.2\% 升至 S800 的 93.2\%，而 CompF1（左轴，红色）从未超过 0.069，最终跌至基线以下。在正则化下延长训练会加剧而非缓解塌缩。}{figure.caption.15}{}}
\newlabel{fig:v11_collapse@cref}{{[figure][11][]11}{[1][8][]16}{}{}{}}
